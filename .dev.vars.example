# 本地开发用的环境变量。复制为 .dev.vars 后填写。
# .dev.vars 已在 .gitignore 中，不会被提交。
#
# 线上环境不用这个文件，改在 Cloudflare 控制台配置：
#   Workers & Pages → partnerrealm → Settings → Variables and Secrets
# 或用命令：wrangler secret put <名称>

# ---- 必填 ----

# 后台登录口令
ADMIN_PASSWORD=换成你的本地口令

# 会话签名密钥，至少 32 字符。生成方法：
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=换成一串至少32字符的随机字符串0123456789

# ---- 可选，留空即用默认值 ----

# 登录有效期（小时），默认 8，范围 1–720
# SESSION_TTL_HOURS=8

# 允许连续登录失败的次数，默认 8，范围 3–100
# LOGIN_MAX_FAILS=8

# 失败计数窗口（分钟），默认 15，范围 1–1440
# LOGIN_WINDOW_MINUTES=15

# 门户公开接口的缓存时长（秒），默认 60，范围 0–86400；设为 0 表示不缓存
# PUBLIC_CACHE_SECONDS=60
